# SAP HANA Cloud
HANA_ADDRESS=your-hana-host.hanacloud.ondemand.com
HANA_PORT=443
HANA_USER=AIUSER
HANA_PASSWORD=replace-with-hana-password

# Agente Forense Postmortem (Google Gemini)
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Envio de reportes Postmortem PDF por correo (elige Resend, Brevo o SMTP)
# Opciones de EMAIL_PROVIDER: auto (default), resend, brevo, smtp
EMAIL_PROVIDER=auto

# Opcion 1: Resend API (HTTPS 443 - recomendado con dominio verificado)
RESEND_API_KEY=re_replace_with_your_key
EMAIL_FROM=Forestia SOC Observability <no-reply@forestia.cloud>

# Opcion 2: Brevo API (HTTPS 443 - envia a cualquier destinatario verificando un solo correo Gmail/Outlook)
# BREVO_API_KEY=xkeysib-replace-with-your-key
# EMAIL_FROM=SAP SOC Observability <tu_correo_verificado@gmail.com>

# Opcion 3: SMTP (ej. Gmail App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
